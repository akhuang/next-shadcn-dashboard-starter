# ============================================
# Development & Production Environment Variables
# Copy this file to .env or .env.local
# ============================================

# ============================================
# Database Configuration
# ============================================
# For local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/navigation_db?schema=public"
# For Docker deployment (use postgres as host)
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/navigation_db?schema=public"

# PostgreSQL Settings (for Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=navigation_db
POSTGRES_PORT=5432

# ============================================
# Redis Configuration
# ============================================
# For local development
REDIS_HOST=localhost
# For Docker deployment (use redis as host)
# REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Excel Monitoring Configuration
# ============================================
# For local development
EXCEL_WATCH_DIR=/tmp/test-contacts
NAVIGATION_EXCEL_DIR=/tmp/test-navigation
# For Docker deployment
# EXCEL_WATCH_DIR=/data/contacts
# NAVIGATION_EXCEL_DIR=/data/navigation

# ============================================
# Authentication
# ============================================
# Set to false to disable authentication in development
ENABLE_AUTH=false

# Clerk Authentication (if ENABLE_AUTH=true)
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ============================================
# Docker Deployment Ports
# ============================================
# HTTP port for Nginx (Docker only)
HTTP_PORT=8088
# HTTPS port for Nginx (Docker only)
HTTPS_PORT=8444
# Next.js port (usually not changed)
NEXTJS_PORT=3000

# ============================================
# Analytics (Optional)
# ============================================
# Microsoft Clarity
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Plausible Analytics (self-hosted)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_HOST=

# ============================================
# Error Tracking (Optional)
# ============================================
# Sentry
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ============================================
# Proxy Settings (Optional)
# ============================================
# Uncomment if behind corporate proxy
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,redis,postgres

# ============================================
# Other Settings
# ============================================
# Timezone
TZ=Asia/Shanghai

# Node environment
NODE_ENV=development

# Site URL (for generating absolute URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000