# AD/LDAP Configuration
# 域控制器地址 (例如: ldap://dc.company.local:389 或 ldaps://dc.company.local:636)
LDAP_URL=ldap://your-dc-server:389

# Base DN (例如: DC=company,DC=local)
LDAP_BASE_DN=DC=company,DC=local

# 可选: 绑定 DN 模式 (例如: DOMAIN\\{{username}} 或 {{username}}@domain.com)
# 如果不设置，将自动使用 UPN 格式
# LDAP_BIND_DN={{username}}@company.local

# 搜索过滤器 (默认使用 sAMAccountName)
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})

# 如果使用 LDAPS，是否验证证书
LDAP_TLS_REJECT_UNAUTHORIZED=true

# JWT Secret (至少32个字符)
JWT_SECRET=your-secret-key-at-least-32-chars-long-change-this!!!