{
  "manifest_version": 3,
  "name": "联系人查询助手",
  "version": "1.0.0",
  "description": "在任何网页快速查询联系人信息，无需切换系统",
  "author": "Your Company",
  
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:8088/*",
    "http://localhost:8089/*",
    "https://localhost:8444/*",
    "https://localhost:8445/*"
  ],
  
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/utils.js",
        "lib/storage.js",
        "lib/api.js",
        "content/detector.js",
        "content/extractor.js",
        "content/ui/floating-button.js",
        "content/ui/sidebar.js",
        "content/ui/inline-results.js",
        "content/ui/quick-card.js",
        "content/ui/iframe-card.js",
        "content/main.js"
      ],
      "css": ["content/styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  
  "options_page": "options/options.html",
  
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["content/styles/content.css", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}