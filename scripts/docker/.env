# Docker Compose 环境变量配置

# Docker 端口配置
HTTP_PORT=8088
HTTPS_PORT=8444
NEXTJS_PORT=3004

# Redis 配置
REDIS_PASSWORD=
REDIS_DB=0

# 可选配置
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# 代理设置（构建时使用，内网环境需要设置）
# 例如: HTTP_PROXY=http://proxy.company.com:8080
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,redis

# PostgreSQL 配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=navigation_db
POSTGRES_PORT=5432

# 域登录认证配置 (LDAP/AD)
# ==================
# 认证模式 - development(开发，无需域认证)/production(生产，启用AD认证)
AUTH_MODE=development

# LDAP/AD 服务器配置（生产环境使用）
# LDAP_URL=ldap://dc.example.com:389
# LDAP_BASE_DN=DC=example,DC=com
# LDAP_BIND_DN=CN=ldap-reader,OU=Service Accounts,DC=example,DC=com
# LDAP_BIND_PASSWORD=your-bind-password
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# JWT 密钥 - 开发环境默认密钥
JWT_SECRET=dev-jwt-secret-key-for-local-development-only-change-in-production

# SSL/TLS 配置
LDAP_TLS_REJECT_UNAUTHORIZED=false
LDAP_USER_FILTER=
LDAP_DEBUG=false