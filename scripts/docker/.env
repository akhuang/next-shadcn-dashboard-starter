# ==========================================
# Docker 生产环境配置
# ==========================================

# ==========================================
# 核心配置 - 必须配置
# ==========================================

# Docker 端口配置
HTTP_PORT=8088
HTTPS_PORT=8444
NEXTJS_PORT=3004

# 应用 URL（生产环境地址）
NEXT_PUBLIC_APP_URL=https://dashboard.example.com

# Node.js 环境
NODE_ENV=production

# 认证配置
AUTH_TYPE=ldap
# AUTH_TYPE=mock  # 测试时可使用 mock

# JWT 和会话配置
JWT_SECRET=GVMSNPHm/vviqfSpEpOcevKZylnBeKbp/uQqf+XlaOqNl7XgU9+EvcSny/moOEKv
SESSION_SECRET=prod-super-secret-session-key-min-32-chars-long!!!

# ==========================================
# LDAP/AD 域账号认证配置（生产环境）
# ==========================================
# LDAP 服务器配置
LDAP_URL=ldap://dc.example.com:389
# LDAP_URL=ldaps://dc.example.com:636  # 使用 LDAPS

# LDAP 搜索基础 DN
LDAP_BASE_DN=DC=example,DC=com

# LDAP 绑定账号（可选，用于查询）
LDAP_BIND_DN=CN=service-account,CN=Users,DC=example,DC=com
LDAP_BIND_PASSWORD=your-bind-password

# 用户搜索配置
LDAP_USER_SEARCH_BASE=CN=Users,DC=example,DC=com
LDAP_USER_SEARCH_FILTER=(sAMAccountName={{username}})

# SSL/TLS 配置
LDAP_TLS_REJECT_UNAUTHORIZED=false
LDAP_DEBUG=false

# ==========================================
# Mock 认证配置（测试环境使用）
# ==========================================
# MOCK_USERNAME=admin
# MOCK_PASSWORD=admin123

# ==========================================
# 数据库配置
# ==========================================
# PostgreSQL 配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres@2024
POSTGRES_DB=navigation_db
POSTGRES_PORT=5432

# 数据库连接字符串（容器内部使用）
DATABASE_URL=postgresql://postgres:postgres@2024@postgres:5432/navigation_db
DATABASE_CONNECTION_LIMIT=20

# ==========================================
# Redis 配置（缓存）
# ==========================================
REDIS_PASSWORD=redis@2024
REDIS_DB=0
REDIS_URL=redis://:redis@2024@redis:6379/0

# ==========================================
# 生产环境配置
# ==========================================
DEBUG=false
LOG_LEVEL=warn
API_TIMEOUT=30000

# ==========================================
# 代理设置（构建时使用，内网环境需要设置）
# ==========================================
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,redis,postgres

# ==========================================
# 可选配置
# ==========================================

# Umami 用户行为追踪（可选）
# NEXT_PUBLIC_UMAMI_URL=https://analytics.example.com
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-production-website-id

# ==========================================
# 已禁用的配置
# ==========================================

# Sentry 错误追踪（已禁用）
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Microsoft Clarity（已禁用）
NEXT_PUBLIC_CLARITY_ID=