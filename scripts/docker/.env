# Docker Compose 生产环境配置

# Docker 端口配置
HTTP_PORT=8088
HTTPS_PORT=8444
NEXTJS_PORT=3004

# Redis 配置
REDIS_PASSWORD=your-redis-password-here
REDIS_DB=0

# PostgreSQL 配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_DB=navigation_db
POSTGRES_PORT=5432

# 代理设置（构建时使用，内网环境需要设置）
# 例如: HTTP_PROXY=http://proxy.company.com:8080
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,redis,postgres

# 域登录认证配置 (LDAP/AD)
# ==================
# 认证模式 - production 启用 AD 认证
AUTH_MODE=production

# LDAP/AD 服务器配置
# 示例: ldap://dc.example.com:389 或 ldaps://dc.example.com:636
LDAP_URL=ldap://dc.example.com:389
# 示例: DC=example,DC=com
LDAP_BASE_DN=DC=example,DC=com
# 示例: CN=ldap-reader,OU=Service Accounts,DC=example,DC=com (可留空)
LDAP_BIND_DN=
# 绑定账号密码 (可留空)
LDAP_BIND_PASSWORD=

# JWT 密钥 - 强随机密钥（生产环境请保密）
JWT_SECRET=GVMSNPHm/vviqfSpEpOcevKZylnBeKbp/uQqf+XlaOqNl7XgU9+EvcSny/moOEKv

# SSL/TLS 配置（使用 LDAPS 时设置为 false 可忽略证书验证）
LDAP_TLS_REJECT_UNAUTHORIZED=false

# 用户过滤器（可选，限制特定用户组）
# 示例: (&(objectClass=user)(memberOf=CN=AppUsers,OU=Groups,DC=example,DC=com))
LDAP_USER_FILTER=

# 调试模式（生产环境设置为 false）
LDAP_DEBUG=false