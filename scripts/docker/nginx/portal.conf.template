# Next.js Dashboard Portal - Nginx Configuration
# 支持 HTTPS、反向代理和 iframe 嵌入

# 代理缓存配置（用于静态资源）
proxy_cache_path /var/cache/nginx levels=1:2 keys_zone=STATIC:10m inactive=24h use_temp_path=off;

# 上游服务器配置
upstream dashboard_app {
    server app:3000;
    keepalive 64;
}

# Plausible Analytics 目标主机（使用变量 + resolver，避免启动时解析失败）
# 注意：仅在收到 /analytics 相关请求时才解析，避免 Plausible 未启动导致 Nginx 退出

# HTTP 服务器配置 - 仅用于重定向到 HTTPS
server {
    listen 80;
    server_name _;

    # 健康检查端点（保留在 HTTP 以便简单监控）
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # 所有其它请求跳转到 HTTPS（使用环境变量端口）
    location / {
        return 301 https://$host:${HTTPS_PORT}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    ssl_certificate     /etc/nginx/certs/portal.crt;
    ssl_certificate_key /etc/nginx/certs/portal.key;
    server_name _;

    # 安全头部 - 允许 iframe 嵌入
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # 移除 X-Frame-Options 以允许 iframe 嵌入
    # add_header X-Frame-Options "SAMEORIGIN" always;
    # CSP 配置：允许更广泛的 iframe 嵌入
    add_header Content-Security-Policy "frame-ancestors 'self' https://* http://localhost:*" always;
    # 注意：不在全局添加 Set-Cookie，防止注入无效 Cookie 头

    # Gzip 压缩
    gzip on;
    gzip_disable "msie6";
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss application/rss+xml application/atom+xml image/svg+xml;

    # 日志
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    # 客户端配置
    client_max_body_size 100M;
    client_body_buffer_size 128k;

    # ---- 门户主应用 ----
    location / {
        proxy_pass http://dashboard_app;
        proxy_http_version 1.1;

        # WebSocket 支持
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;

        # 标准代理头
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $server_name;

        # 性能优化
        proxy_buffering off;
        proxy_redirect off;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # ---- Next.js 静态文件优化 ----
    location /_next/static {
        proxy_pass http://dashboard_app;
        proxy_cache STATIC;
        proxy_cache_valid 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # ---- 公共静态资源 ----
    location /static {
        proxy_pass http://dashboard_app;
        proxy_cache STATIC;
        proxy_cache_valid 60m;
        add_header Cache-Control "public, max-age=3600";
    }

    # ---- 图片和媒体文件缓存 ----
    location ~* \.(jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$ {
        proxy_pass http://dashboard_app;
        proxy_cache STATIC;
        proxy_cache_valid 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    # ---- API 路由（不缓存） ----
    location /api {
        proxy_pass http://dashboard_app;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # 禁用缓存
        proxy_cache_bypass $http_upgrade;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
    }

    # 供动态域名解析使用（Docker 内置 DNS）
    resolver 127.0.0.11 valid=30s;

    # Plausible 目标主机（延迟解析，避免启动失败）
    set $plausible_host plausible:8000;

    # ---- Plausible Analytics 分析服务 ----
    location /analytics {
        # 移除 /analytics 前缀并代理到 Plausible
        rewrite ^/analytics(/.*)$ $1 break;
        proxy_pass http://$plausible_host;
        
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        
        # WebSocket 支持（用于实时仪表板）
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
        
        # 设置较长的超时时间
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
    
    # Plausible 追踪脚本
    location = /js/script.js {
        proxy_pass http://$plausible_host/js/script.js;
        proxy_set_header Host $host;
        proxy_cache_valid 6h;
        add_header Cache-Control "public, max-age=21600";
    }
    
    # Plausible API 端点
    location = /api/event {
        proxy_pass http://$plausible_host/api/event;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
    }

    # ---- HTTP站点代理：解决iframe混合内容限制 ----
    # 将HTTP站点通过HTTPS代理，解决混合内容安全策略
    # 示例：/http-proxy/192.168.1.100:8080/path -> http://192.168.1.100:8080/path
    location ~* "^/http-proxy/(?<target_host>[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}):(?<target_port>[0-9]+)(?<target_path>/.*)?$" {
        # 代理到HTTP目标服务
        proxy_pass http://$target_host:$target_port$target_path$is_args$args;
        
        proxy_set_header Host              $target_host:$target_port;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        
        # 移除阻止iframe的响应头
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        
        # 允许跨域
        add_header Access-Control-Allow-Origin * always;
        
        # 缓存设置
        proxy_cache_bypass 1;
        proxy_no_cache 1;
    }
    
    # ---- 通用代理：支持代理外部HTTPS服务 ----
    # 示例：/proxy/example.com/path -> https://example.com/path  
    location ~ ^/proxy/(?<target_host>[a-zA-Z0-9.-]+\.[a-zA-Z]+)(?<target_path>/.*)?$ {
        # 必须使用 resolver 来解析动态域名
        resolver 127.0.0.11 valid=30s;
        resolver_timeout 5s;
        
        # SSL 配置
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_ssl_server_name on;
        proxy_ssl_verify off;
        
        proxy_pass https://$target_host$target_path$is_args$args;
        
        proxy_set_header Host              $target_host;
        proxy_set_header Referer           https://$target_host/;
        proxy_set_header Origin            https://$target_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        
        # 移除<meta http-equiv="Content-Security-Policy ...> 标签（若有）
        sub_filter '<meta http-equiv="Content-Security-Policy' '<meta removed="csp" ';
        sub_filter_once off;
        
        # 移除阻止 iframe 的头部
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        
        # 为 iframe 中的 Cookie 添加必要属性
        proxy_cookie_flags ~ SameSite=None Secure;
        
        # 允许被更广泛的域嵌入
        add_header Content-Security-Policy "frame-ancestors 'self' https://* http://localhost:*" always;
        # 确保 Cookie 在 iframe 中可用
        add_header Set-Cookie "Path=/; HttpOnly; Secure; SameSite=None" always;
    }

    # ---- 健康检查端点 ----
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # ---- 错误页面 ----
    error_page 404 /404;
    error_page 500 502 503 504 /500;

    location = /404 {
        proxy_pass http://dashboard_app/404;
    }

    location = /500 {
        proxy_pass http://dashboard_app/500;
    }
}
