# 华为域账号配置示例
# ==================
# 将此文件复制为 .env.huawei 并填入实际配置

# Docker 端口配置
HTTP_PORT=8088
HTTPS_PORT=8444
NEXTJS_PORT=3004

# Redis 配置
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL 配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=navigation_db
POSTGRES_PORT=5432

# 代理设置（构建时使用，内网环境需要设置）
# 例如: HTTP_PROXY=http://proxy.huawei.com:8080
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,redis,postgres

# 域登录认证配置 (LDAP/AD)
# ==================
# 认证模式 - 使用生产模式启用 AD 认证
AUTH_MODE=production

# LDAP/AD 服务器配置
# 请替换为实际的域控制器地址
LDAP_URL=ldap://dc.china.huawei.com:389
# 或使用加密连接
# LDAP_URL=ldaps://dc.china.huawei.com:636

# LDAP Base DN - 华为域
LDAP_BASE_DN=DC=china,DC=huawei,DC=com

# LDAP Bind DN - 留空以支持匿名绑定或用户自身绑定
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# JWT 密钥 - 请更改为强随机密钥（至少32字符）
JWT_SECRET=huawei-domain-jwt-secret-key-change-this-in-production-at-least-32-chars

# SSL/TLS 配置（使用 LDAPS 时）
LDAP_TLS_REJECT_UNAUTHORIZED=false

# 可选：指定搜索过滤器（如果需要限制特定用户组）
# LDAP_USER_FILTER=(&(objectClass=user)(memberOf=CN=AppUsers,OU=Groups,DC=china,DC=huawei,DC=com))

# 调试模式（生产环境请设置为 false）
LDAP_DEBUG=false

# Microsoft Clarity Analytics (Optional)
NEXT_PUBLIC_CLARITY_PROJECT_ID=