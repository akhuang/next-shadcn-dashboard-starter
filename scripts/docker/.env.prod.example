# =================================================================
# Production Environment Configuration
# =================================================================
# Copy this file to .env.prod and fill in your production values
# DO NOT commit .env.prod to version control

# =================================================================
# Authentication Configuration (Clerk)
# =================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_production_clerk_publishable_key
CLERK_SECRET_KEY=your_production_clerk_secret_key

# Authentication Redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard/overview
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard/overview

# =================================================================
# Analytics Configuration (Self-hosted Plausible)
# =================================================================
# Analytics is now self-hosted using Plausible Analytics
# Access the dashboard at: https://your-domain/analytics

# Site domain for analytics tracking
NEXT_PUBLIC_SITE_DOMAIN=your-domain.com

# Enable/disable analytics (set to "false" to disable)
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# Plausible Configuration
PLAUSIBLE_BASE_URL=https://your-domain.com/analytics
PLAUSIBLE_SECRET_KEY=replace-me-with-a-random-64-char-string
PLAUSIBLE_DB_PASSWORD=secure-database-password
PLAUSIBLE_ADMIN_EMAIL=admin@your-domain.com
PLAUSIBLE_ADMIN_NAME=Admin
PLAUSIBLE_ADMIN_PASSWORD=changeme123
PLAUSIBLE_DISABLE_REGISTRATION=true

# =================================================================
# Error Tracking Configuration (Sentry)
# =================================================================
# Sentry DSN for production error tracking
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Disable Sentry in production (set to "true" to disable)
NEXT_PUBLIC_SENTRY_DISABLED=false

# =================================================================
# Docker Configuration
# =================================================================
# HTTP and HTTPS ports for Nginx
HTTP_PORT=80
HTTPS_PORT=443

# =================================================================
# Additional Production Settings
# =================================================================
# Add any other production-specific environment variables here