# 生产环境配置

# ============================================
# Docker 部署配置
# ============================================
HTTP_PORT=8088
HTTPS_PORT=8444
NODE_ENV=production
TZ=Asia/Shanghai
COMPOSE_PROJECT_NAME=nextjs-dashboard

# ============================================
# Next.js 应用配置 - 生产环境
# ============================================

# 临时禁用认证（开发/测试环境）
ENABLE_AUTH=false

# 认证配置 (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard/overview"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard/overview"

# 错误追踪 (Sentry) - 生产环境
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DISABLED="false"  # 生产环境启用 Sentry

# 应用运行配置
HOSTNAME=0.0.0.0
# PORT=3000  # 容器内部端口，通常不需要修改

# ============================================
# Excel 文件监控配置
# ============================================
# Excel 文件宿主机映射目录
EXCEL_HOST_DIR=./excel-data

# Excel 文件监控目录（容器内路径）
EXCEL_WATCH_DIR=/tmp/test-contacts

# 文件监控配置
EXCEL_WATCH_POLLING=false
EXCEL_WATCH_INTERVAL=1000

# ============================================
# Redis 配置（用于 Excel 数据缓存）
# ============================================
# Redis 密码（请在生产环境修改此密码）
REDIS_PASSWORD=redis_dashboard_prod_2024

# Redis 数据库编号
REDIS_DB=0

# Redis 连接配置（容器内部通信，这些在 docker-compose.yml 中设置）
# REDIS_HOST=redis
# REDIS_PORT=6379

# ============================================
# Analytics 配置（可选）
# ============================================
# Microsoft Clarity Analytics
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Site domain for analytics tracking
NEXT_PUBLIC_SITE_DOMAIN=localhost

# Enable/disable analytics
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ============================================
# 代理配置（如果需要）
# ============================================
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080
# NO_PROXY=localhost,127.0.0.1,*.local