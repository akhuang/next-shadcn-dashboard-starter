# Plausible Analytics Configuration

# Base URL - 修改为你的域名
PLAUSIBLE_BASE_URL=http://localhost:8000
# 允许非 HTTPS 网站
PLAUSIBLE_ALLOW_NON_HTTPS=true

# Secret key - 请生成一个随机的64字符字符串
# 可以使用: openssl rand -base64 48
PLAUSIBLE_SECRET_KEY=tZQzovXPlI5xXeDL5cJSbQL0BjV5T1PuHOOjAOauxjt/XTwFEuqLE6A+Y1xh9E5m

# 数据库密码
PLAUSIBLE_DB_PASSWORD=plausible-db-password

# 禁用注册（仅管理员可创建账户）
PLAUSIBLE_DISABLE_REGISTRATION=true

# 管理员账户（首次启动时创建）
PLAUSIBLE_ADMIN_EMAIL=admin@example.com
PLAUSIBLE_ADMIN_NAME=Admin
PLAUSIBLE_ADMIN_PASSWORD=changeme123

# 邮件配置（可选）
PLAUSIBLE_MAILER_ENABLED=false