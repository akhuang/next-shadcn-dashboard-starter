# ==========================================
# 核心配置 - 必须配置
# ==========================================

# 基础 URL 配置
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 认证配置
# 使用 mock 认证（开发环境）或 ldap 认证（生产环境）
AUTH_TYPE=mock
# AUTH_TYPE=ldap

# Mock 认证配置（开发环境使用）
MOCK_USERNAME=admin
MOCK_PASSWORD=admin123

# JWT 和会话配置（已生成随机密钥）
JWT_SECRET=/9Rha7C26q0gSw0vcwmGdWyWlPJeH77sPiDVHjmyQvn/AYYkFsdAYbOPXVIwzKRU
SESSION_SECRET=4d/1zg8GCpkOVvaRdUQCXVs91RmZ2/ywytBjtQylbJrdZn2dMjvjmosMKt7OGR26

# ==========================================
# LDAP/AD 认证配置（生产环境使用）
# ==========================================
# LDAP_URL=ldap://your-domain-controller.example.com:389
# LDAP_BASE_DN=DC=example,DC=com
# LDAP_BIND_DN=CN=service-account,CN=Users,DC=example,DC=com
# LDAP_BIND_PASSWORD=your-bind-password
# LDAP_USER_SEARCH_BASE=CN=Users,DC=example,DC=com
# LDAP_USER_SEARCH_FILTER=(sAMAccountName={{username}})
# LDAP_TLS_REJECT_UNAUTHORIZED=false
# LDAP_DEBUG=false

# ==========================================
# 数据库配置（如果需要）
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/navigation_db
DATABASE_CONNECTION_LIMIT=10

# Redis 配置（如果需要缓存）
REDIS_URL=redis://localhost:6379

# ==========================================
# 开发环境配置
# ==========================================
NODE_ENV=development
DEBUG=true
LOG_LEVEL=info
API_TIMEOUT=30000

# ==========================================
# 可选配置
# ==========================================

# Umami 用户行为追踪（可选）
# NEXT_PUBLIC_UMAMI_URL=https://analytics.example.com
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id

# ==========================================
# 已禁用的配置
# ==========================================

# Sentry 错误追踪（已禁用）
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Microsoft Clarity（已禁用）
NEXT_PUBLIC_CLARITY_ID=