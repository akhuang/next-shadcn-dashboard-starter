# 开发环境 Dockerfile - 快速构建，支持热重载

FROM node:20-slim

# 安装基础工具
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 安装 pnpm
RUN npm install -g pnpm@latest

# 复制依赖文件
COPY package.json pnpm-lock.yaml ./
COPY .npmrc ./

# 安装依赖
RUN pnpm install

# 复制源代码
COPY . .

# 创建.env文件，设置开发环境需要的变量
RUN echo "NODE_ENV=development" > .env && \
    echo "NEXT_PUBLIC_APP_URL=http://localhost:3000" >> .env && \
    echo "NEXT_PUBLIC_SENTRY_DISABLED=true" >> .env

# 使用简化的开发配置
RUN mv next.config.ts next.config.prod.ts && mv next.config.dev.ts next.config.ts

# 暴露端口
EXPOSE 3000

# 开发模式启动，明确不使用 turbopack
CMD ["npx", "next", "dev"]