# 开发环境 Dockerfile - 快速构建，支持热重载

FROM node:20

# 配置代理环境变量
ARG HTTP_PROXY
ARG HTTPS_PROXY  
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy

ENV HTTP_PROXY=${HTTP_PROXY:-${http_proxy}}
ENV HTTPS_PROXY=${HTTPS_PROXY:-${https_proxy}}
ENV NO_PROXY=${NO_PROXY:-${no_proxy}}
ENV http_proxy=${http_proxy:-${HTTP_PROXY}}
ENV https_proxy=${https_proxy:-${HTTPS_PROXY}}
ENV no_proxy=${no_proxy:-${NO_PROXY}}
ENV NODE_TLS_REJECT_UNAUTHORIZED=0


WORKDIR /app

# 配置 npm 代理（如果存在）
RUN if [ -n "$HTTP_PROXY" ]; then npm config set proxy $HTTP_PROXY; fi && \
    if [ -n "$HTTPS_PROXY" ]; then npm config set https-proxy $HTTPS_PROXY; fi && \
    npm config set strict-ssl false

# 安装 pnpm
RUN npm install -g pnpm@latest

# 配置 pnpm 代理（如果存在）
RUN if [ -n "$HTTP_PROXY" ]; then pnpm config set proxy $HTTP_PROXY; fi && \
    if [ -n "$HTTPS_PROXY" ]; then pnpm config set https-proxy $HTTPS_PROXY; fi && \
    pnpm config set strict-ssl false

# 只复制依赖文件用于安装
COPY package.json pnpm-lock.yaml ./
COPY .npmrc ./

# 安装依赖
RUN pnpm install

# 暴露端口
EXPOSE 3000

# 开发模式启动
CMD ["pnpm", "run", "dev"]