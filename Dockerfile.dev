# 开发环境 Dockerfile - 快速构建，支持热重载

FROM node:20-slim

# 安装基础工具
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 安装 pnpm
RUN npm install -g pnpm@latest

# 只复制依赖文件用于安装
COPY package.json pnpm-lock.yaml ./
COPY .npmrc ./

# 安装依赖
RUN pnpm install

# 暴露端口
EXPOSE 3000

# 开发模式启动
CMD ["pnpm", "run", "dev"]