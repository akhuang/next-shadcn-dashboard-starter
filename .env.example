# ============================================
# Environment Variables Example
# Copy this file to .env and update values
# ============================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/navigation_db?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=navigation_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Excel Monitoring Directories
EXCEL_WATCH_DIR=/tmp/test-contacts
NAVIGATION_EXCEL_DIR=/tmp/test-navigation

# Docker Ports (optional, for production)
HTTP_PORT=8088
HTTPS_PORT=8444

# Authentication (optional)
ENABLE_AUTH=false

# Other
TZ=Asia/Shanghai
NODE_ENV=development