# ============================================
# Environment Variables Example
# Copy this file to .env and update values
# ============================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/navigation_db?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=navigation_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Excel Monitoring Directories
EXCEL_WATCH_DIR=/tmp/test-contacts
NAVIGATION_EXCEL_DIR=/tmp/test-navigation

# Docker Ports (optional, for production)
HTTP_PORT=8088
HTTPS_PORT=8444

# Authentication (optional)
ENABLE_AUTH=false

# Umami Analytics (optional)
# Get these values from your Umami dashboard after creating a website
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_URL=http://localhost:3000
NEXT_PUBLIC_UMAMI_SCRIPT_NAME=analytics.js
NEXT_PUBLIC_APP_DOMAIN=localhost

# Other
TZ=Asia/Shanghai
NODE_ENV=development