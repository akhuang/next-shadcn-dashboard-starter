# ========================================
# Umami 用户追踪配置
# ========================================
# Umami 服务器地址（不要包含尾部斜杠）
NEXT_PUBLIC_UMAMI_URL=http://your-umami-server.com

# Umami 网站 ID
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id

# ========================================
# Sentry 错误追踪配置（可选）
# ========================================
# Sentry DSN
NEXT_PUBLIC_SENTRY_DSN=

# Sentry 认证令牌（用于源码映射上传）
SENTRY_AUTH_TOKEN=

# ========================================
# 数据库配置
# ========================================
# PostgreSQL 连接字符串
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ========================================
# Redis 配置（用于缓存）
# ========================================
REDIS_URL=redis://localhost:6379

# ========================================
# LDAP/AD 域账号认证配置
# ========================================
# LDAP 服务器地址
LDAP_URL=ldap://your-domain-controller.com

# LDAP 绑定 DN（用于查询）
LDAP_BIND_DN=CN=ServiceAccount,CN=Users,DC=domain,DC=com

# LDAP 绑定密码
LDAP_BIND_PASSWORD=

# LDAP 搜索基础 DN
LDAP_SEARCH_BASE=DC=domain,DC=com

# LDAP 搜索过滤器
LDAP_SEARCH_FILTER=(&(objectClass=user)(sAMAccountName={{username}}))

# ========================================
# 应用配置
# ========================================
# 应用 URL（用于生成绝对 URL）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API 超时时间（毫秒）
API_TIMEOUT=30000

# 会话密钥（用于加密会话数据）
SESSION_SECRET=your-super-secret-session-key-min-32-chars

# ========================================
# 开发环境配置
# ========================================
# 启用调试模式
DEBUG=false

# 日志级别 (error, warn, info, debug)
LOG_LEVEL=info